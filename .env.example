# ============================================================
# crypto-compound-bot — environment variable template
# Copy this to .env and fill in your values.
# NEVER commit .env to GitHub.
# ============================================================

# --- Exchange credentials (read-only keys only for now) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading mode: paper | live (live NOT enabled yet) ---
TRADING_MODE=paper
EXCHANGE=binance
BASE_CURRENCY=USDT

# --- Paper trading starting balance ---
STARTING_BALANCE=2000

# --- Safety switches ---
KILL_SWITCH=false

# --- Risk limits (percentage of account, 0.0 - 1.0) ---
MAX_DAILY_LOSS_PCT=0.03
MAX_TRADE_SIZE_PCT=0.05
MAX_OPEN_EXPOSURE_PCT=0.20
CONFIDENCE_THRESHOLD=0.65

# --- Cooldown after consecutive losses (seconds) ---
LOSS_COOLDOWN_SECONDS=300
MAX_CONSECUTIVE_LOSSES=3

# --- Logging ---
LOG_LEVEL=INFO
